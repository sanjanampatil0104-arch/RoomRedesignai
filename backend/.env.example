# RoomRedesign AI - Environment Configuration

# Optional: Add your Hugging Face API Token (free at huggingface.co/settings/tokens)
# When provided, calls HF image-to-image inference models.
# When left empty, automatically runs the high-fidelity built-in neural/algorithmic stylizer.
HUGGINGFACE_API_KEY=

# Default Hugging Face Image-to-Image / Instruct Model
HUGGINGFACE_MODEL_ID=timbrooks/instruct-pix2pix

# Provider: "auto", "huggingface", or "local-engine"
DEFAULT_PROVIDER=auto

# Maximum upload limit in megabytes
MAX_UPLOAD_SIZE_MB=10
